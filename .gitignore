# Ignore Python cache and temp files
__pycache__/
*.pyc
*.pyo
*.pyd
*.swp
*.tmp
*.log


# Ignore virtual environment
venv/

# Ignore data and runs but keep empty folders
train/*
test/*
valid/*
runs/*
InsectClassificationModel/*
Manual-Test-Data/*
DWD-Data/*
dwd_neurath.xlsx
.python-version

# Keep .gitkeep so the folders stay in repo
!train/.gitkeep
!test/.gitkeep
!valid/.gitkeep
!runs/.gitkeep
!InsectClassificationModel/.gitkeep

# Ignore system files
.DS_Store
Thumbs.db

# Ignore insect datasets
Insect-Types-Classes/*
foundInsects/*

# But keep empty folder with .gitkeep
!Insect-Types-Classes/.gitkeep
!foundInsects/.gitkeep

# Ignore PyTorch model weights
*.pt

# Secrets
.env
*.env

# EXCEPT for the model in AI-Insect-Micro-Service
!Web-Application/Services/AI-Insect-Micro-Service/model/last.pt

# Ignore all files in metrics folder except .gitkeep
insect_classification_model_metrics/*
!insect_classification_model_metrics/.gitkeep

# Historical data (user-provided images)
historical_data/*
!historical_data/.gitkeep

# Historical data results (generated by analysis script)
historical_data_results/*
!historical_data_results/.gitkeep